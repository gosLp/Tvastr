import torch


def reference(A, B, bias):
    """
    Reference implementation for matmul_bias_relu generated by Tvastr.

    Semantics:
    C[i,j] = relu(sum(k, A[i,k] * B[k,j]) + bias[j])

    Contract:
    - inputs: f16
    - accumulation: f32
    - output: f16
    """
    acc = torch.matmul(A.to(torch.float32), B.to(torch.float32))
    acc = acc + bias.to(torch.float32)
    return torch.relu(acc).to(torch.float16)