import torch


def _torch_dtype(dtype: str):
    if dtype == "f16":
        return torch.float16
    if dtype == "f32":
        return torch.float32
    if dtype == "bf16":
        return torch.bfloat16
    raise ValueError(f"unsupported dtype: {dtype}")


def reference(A, B, bias):
    """
    Reference implementation for {{ spec.name }} generated by Tvastr.

    Semantics:
    {{ spec.semantics.get("expression", "") }}
    """

    acc = torch.matmul(A.to(torch.float32), B.to(torch.float32))
    acc = acc + bias.to(torch.float32)
    out = torch.relu(acc)
    return out.to(_torch_dtype("{{ spec.outputs[0].dtype }}"))