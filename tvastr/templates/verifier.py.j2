import torch


def verify(A, B, bias):
    """
    Runtime verifier generated by Tvastr.

    Checks shape and dtype constraints for:
    {{ spec.name }}
    """

    if A.ndim != 2:
        raise ValueError("A must be rank-2")
    if B.ndim != 2:
        raise ValueError("B must be rank-2")
    if bias.ndim != 1:
        raise ValueError("bias must be rank-1")

    M, K = A.shape
    K2, N = B.shape

    if K != K2:
        raise ValueError(f"K mismatch: A.shape[1]={K}, B.shape[0]={K2}")

    if bias.shape[0] != N:
        raise ValueError(f"bias length {bias.shape[0]} must match N={N}")

    if M <= 0 or N <= 0 or K <= 0:
        raise ValueError("M, N, K must be positive")

    if M % 16 != 0:
        raise ValueError(f"M must be divisible by 16, got M={M}")

    if N % 16 != 0:
        raise ValueError(f"N must be divisible by 16, got N={N}")

    if K % 16 != 0:
        raise ValueError(f"K must be divisible by 16, got K={K}")

    if A.dtype != torch.float16:
        raise ValueError(f"A must be torch.float16, got {A.dtype}")

    if B.dtype != torch.float16:
        raise ValueError(f"B must be torch.float16, got {B.dtype}")

    if bias.dtype != torch.float16:
        raise ValueError(f"bias must be torch.float16, got {bias.dtype}")

    return {"M": M, "N": N, "K": K}