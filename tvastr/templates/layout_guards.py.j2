import json


LAYOUTS = {{ spec.layouts | tojson }}
LAYOUT_CONTRACT = {{ spec.layout_contract | tojson }}
LAYOUT_TRANSFORMS = {{ spec.layout_transforms | tojson }}


def _check_rank(name, tensor, expected_rank):
    if tensor.ndim != expected_rank:
        raise ValueError(
            f"{name}: expected rank {expected_rank}, got rank {tensor.ndim}"
        )


def _check_contiguous_last_dim(name, tensor):
    if tensor.ndim < 1:
        raise ValueError(f"{name}: expected tensor with rank >= 1")

    if tensor.stride(-1) != 1:
        raise ValueError(
            f"{name}: expected contiguous_last_dim, "
            f"but stride(-1)={tensor.stride(-1)}"
        )


def _check_dense(name, tensor):
    # Conservative check for now. Later we can distinguish dense-but-non-contiguous layouts.
    if not tensor.is_contiguous():
        raise ValueError(
            f"{name}: expected dense contiguous row-major tensor, "
            f"got shape={tuple(tensor.shape)} strides={tuple(tensor.stride())}"
        )


def _check_contiguous(name, tensor):
    if not tensor.is_contiguous():
        raise ValueError(
            f"{name}: expected contiguous tensor, "
            f"got shape={tuple(tensor.shape)} strides={tuple(tensor.stride())}"
        )


def verify_layouts(A, B, bias):
    """
    Generated by Tvastr.

    Verifies runtime tensor layouts required by the layout contract.
    """

    tensors = {
        "A": A,
        "B": B,
        "bias": bias,
    }

    tensor_contracts = LAYOUT_CONTRACT.get("tensors", {})

    for name, contract in tensor_contracts.items():
        if name == "C":
            # C is allocated by the generated kernel, so input-side verification skips it.
            continue

        if name not in tensors:
            raise ValueError(f"Missing tensor {name} for layout verification")

        tensor = tensors[name]
        layout_name = contract["layout"]
        layout_def = LAYOUTS[layout_name]

        _check_rank(name, tensor, int(layout_def["rank"]))

        for prop in contract.get("required_properties", []):
            if prop == "contiguous_last_dim":
                _check_contiguous_last_dim(name, tensor)
            elif prop == "dense":
                _check_dense(name, tensor)
            elif prop == "contiguous":
                _check_contiguous(name, tensor)
            else:
                raise ValueError(f"{name}: unknown layout property {prop!r}")

    return {
        "ok": True,
        "checked_tensors": list(tensors.keys()),
        "layout_contract": tensor_contracts,
    }


def emit_layout_report(path="layout_report.json"):
    report = {
        "layouts": LAYOUTS,
        "layout_contract": LAYOUT_CONTRACT,
        "layout_transforms": LAYOUT_TRANSFORMS,
    }

    with open(path, "w") as f:
        json.dump(report, f, indent=2)

    return report


def main():
    report = emit_layout_report()
    print("[layout] wrote layout_report.json")
    print(json.dumps(report, indent=2))


if __name__ == "__main__":
    main()